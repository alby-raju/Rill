{
  "openapi": "3.0.3",
  "info": {
    "title": "Rill verification API",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18990"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/json": {
      "get": {
        "operationId": "getDemo",
        "responses": {
          "200": {
            "description": "Demo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/echo": {
      "post": {
        "operationId": "echo",
        "responses": {
          "200": {
            "description": "Echo"
          }
        }
      }
    }
  }
}
